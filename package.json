{
  "name": "norn-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "bun test",
    "test:integration": "bun test --config=bunfig.integration.toml --parallel=6 --timeout=20000",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "schema:emit": "bun packages/schema/scripts/emit.ts",
    "docs:emit": "bun packages/cli/scripts/docs-emit.ts",
    "golden": "bun packages/kernel/scripts/golden.ts",
    "build": "bun scripts/build.ts",
    "build:bin": "bun scripts/build.ts --bin"
  },
  "devDependencies": {
    "@norn/schema": "workspace:*",
    "@norn/cli": "workspace:*",
    "@norn/plugin-api": "workspace:*",
    "@norn/kernel": "workspace:*",
    "@norn/harness-claude": "workspace:*",
    "@norn/harness-pi": "workspace:*",
    "@norn/harness-lab": "workspace:*",
    "@norn/conformance": "workspace:*",
    "@norn/plugin-github": "workspace:*",
    "@norn/tracker-local": "workspace:*",
    "@norn/forge-none": "workspace:*",
    "@norn/host-node": "workspace:*",
    "@norn/store-local": "workspace:*",
    "@norn/store-refs": "workspace:*",
    "@norn/runtime": "workspace:*",
    "@norn/vcs-git": "workspace:*",
    "@norn/pack-sdlc": "workspace:*",
    "@norn/runner-headless": "workspace:*",
    "@norn/runner-herdr": "workspace:*",
    "@types/bun": "1.3.13",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  }
}
