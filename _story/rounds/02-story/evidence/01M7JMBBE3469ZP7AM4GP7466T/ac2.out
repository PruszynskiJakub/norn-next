update-branch: new ok=true model={"type":"git","action":"update","outcomes":{"done":"$done","clean":"$done","resolved":"$done","conflict":{"to":"s","counter":"c"}}} issues=[] | equals old-wording copy: true
open-pr: new ok=true model={"type":"git","action":"open-pr","outcomes":{"done":"$done"}} issues=[] | equals old-wording copy: true
integrate: new ok=true model={"type":"git","action":"integrate","outcomes":{"done":"$done"}} issues=[] | equals old-wording copy: true
push: new ok=true model={"type":"git","action":"push","outcomes":{"done":"$done"}} issues=[] | equals old-wording copy: true
await-merge: new ok=true model={"type":"merge","outcomes":{"stale":{"to":"s","counter":"c"}}} issues=[] | equals old-wording copy: true
slices: new ok=true model={"type":"slices","outcomes":{"done":"$done"}} issues=[] | equals old-wording copy: true

# light outcomes (clean/resolved) on non-update git verbs
open-pr false ["unknown_outcome /steps/s/outcomes/clean 'clean' is an outcome of a base update only (action: update), not of action: open-pr","unknown_outcome /steps/s/outcomes/resolved 'resolved' is an outcome of a base update only (action: update), not of action: open-pr"]
integrate false ["unknown_outcome /steps/s/outcomes/clean 'clean' is an outcome of a base update only (action: update), not of action: integrate","unknown_outcome /steps/s/outcomes/resolved 'resolved' is an outcome of a base update only (action: update), not of action: integrate"]
push false ["unknown_outcome /steps/s/outcomes/clean 'clean' is an outcome of a base update only (action: update), not of action: push","unknown_outcome /steps/s/outcomes/resolved 'resolved' is an outcome of a base update only (action: update), not of action: push"]

# other foreign outcomes
await-merge { done: $done } false [{"path":"/steps/s/outcomes","message":"unknown property 'done'"}]
slices { clean: $done } false [{"path":"/steps/s/outcomes","message":"unknown property 'clean'"}]
update-branch { pass: $done } false [{"path":"/steps/s/outcomes","message":"unknown property 'pass'"}]

# verb with a value
open-pr: now -> {"file":".agents/workflows/wf.yaml","errors":[{"path":"/steps/s/open-pr","message":"`open-pr:` takes no value"}]}
update-branch: main -> {"file":".agents/workflows/wf.yaml","errors":[{"path":"/steps/s/update-branch","message":"`update-branch:` takes no value"}]}
await-merge: yes -> {"file":".agents/workflows/wf.yaml","errors":[{"path":"/steps/s/await-merge","message":"`await-merge:` takes no value"}]}
slices: [a] -> {"file":".agents/workflows/wf.yaml","errors":[{"path":"/steps/s/slices","message":"`slices:` takes no value"}]}
old copy type: merge { done: $done } {"file":".agents/workflows/wf.yaml","errors":[{"path":"/steps/s/outcomes","message":"unknown property 'done'"}]}
old copy type: slices { clean: $done } {"file":".agents/workflows/wf.yaml","errors":[{"path":"/steps/s/outcomes","message":"unknown property 'clean'"}]}
