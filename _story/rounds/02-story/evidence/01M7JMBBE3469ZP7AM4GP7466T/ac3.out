--- new wording with use: (checkout)
{
 "ok": true,
 "issues": [],
 "steps": {
  "b": {
   "type": "agent",
   "instructions": "Build.",
   "outcomes": {
    "done": {
     "to": "rv",
     "means": "built"
    }
   }
  },
  "rv": {
   "type": "agent",
   "instructions": "Review it.",
   "skills": [
    "norn-review"
   ],
   "outcomes": {
    "approve": {
     "to": "$done",
     "means": "fine"
    },
    "changes_requested": {
     "to": "b",
     "counter": "c",
     "means": "findings"
    }
   }
  },
  "t": {
   "type": "check",
   "run": "bun test",
   "timeout": "5m",
   "outcomes": {
    "pass": "$done",
    "fail": {
     "to": "b",
     "counter": "c"
    }
   }
  }
 }
}
