{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://norn.dev/schema/local-issue.json",
  "title": "norn story issues seen (trace/issue.json)",
  "type": "object",
  "properties": {
    "stories": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "type": "object",
          "required": [
            "issue",
            "observed_at"
          ],
          "properties": {
            "issue": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "provider",
                    "number",
                    "url",
                    "title",
                    "body",
                    "state",
                    "assignees",
                    "labels",
                    "updated_at"
                  ],
                  "properties": {
                    "provider": {
                      "description": "Issue provider CLI: gh (GitHub) or glab (GitLab)",
                      "anyOf": [
                        {
                          "const": "gh",
                          "type": "string"
                        },
                        {
                          "const": "glab",
                          "type": "string"
                        }
                      ]
                    },
                    "number": {
                      "type": "number"
                    },
                    "url": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    },
                    "state": {
                      "anyOf": [
                        {
                          "const": "open",
                          "type": "string"
                        },
                        {
                          "const": "closed",
                          "type": "string"
                        }
                      ]
                    },
                    "assignees": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "labels": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "updated_at": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "observed_at": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
