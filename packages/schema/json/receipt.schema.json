{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://norn.dev/schema/receipt.json",
  "title": "norn receipt",
  "type": "object",
  "oneOf": [
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "receipt_id",
        "run_id",
        "step",
        "attempt",
        "at",
        "by",
        "outcome",
        "handoff"
      ],
      "properties": {
        "kind": {
          "const": "done",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID (ID2)",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "description": "ULID (ID2)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "step": {
          "anyOf": [
            {
              "pattern": "^(?!(done|stuck|ask|exhausted|silent|died|timeout|stalled)$)[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "const": "$done",
              "type": "string"
            },
            {
              "const": "$stuck",
              "type": "string"
            }
          ]
        },
        "attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "at": {
          "format": "date-time",
          "description": "ISO-8601 timestamp, UTC",
          "type": "string"
        },
        "by": {
          "anyOf": [
            {
              "const": "agent",
              "type": "string"
            },
            {
              "const": "human",
              "type": "string"
            },
            {
              "const": "norn",
              "type": "string"
            }
          ]
        },
        "who": {
          "minLength": 1,
          "type": "string"
        },
        "tick_id": {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "ULID (ID2)",
          "type": "string"
        },
        "slice": {
          "anyOf": [
            {
              "pattern": "^(gh|gl)-[1-9][0-9]*/[0-9]{2,3}$",
              "description": "Slice key, e.g. gh-123/03",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "type": "string"
        },
        "handoff": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "severity",
              "title"
            ],
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "severity": {
                "anyOf": [
                  {
                    "const": "blocking",
                    "type": "string"
                  },
                  {
                    "const": "major",
                    "type": "string"
                  },
                  {
                    "const": "minor",
                    "type": "string"
                  },
                  {
                    "const": "nit",
                    "type": "string"
                  }
                ]
              },
              "title": {
                "minLength": 1,
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "file": {
                "minLength": 1,
                "type": "string"
              },
              "line": {
                "minimum": 1,
                "type": "integer"
              },
              "criterion": {
                "minLength": 1,
                "type": "string"
              },
              "repro": {
                "type": "string"
              }
            }
          }
        },
        "evidence": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
