{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://norn.dev/schema/slice.json",
  "title": "norn slice frontmatter",
  "additionalProperties": true,
  "type": "object",
  "required": [
    "id",
    "title",
    "depends_on",
    "status"
  ],
  "properties": {
    "id": {
      "pattern": "^(gh|gl)-[1-9][0-9]*/[0-9]{2,3}$",
      "description": "Slice key, e.g. gh-123/03",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "workflow": {
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Name of a workflow file",
      "type": "string"
    },
    "depends_on": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "pattern": "^(gh|gl)-[1-9][0-9]*/[0-9]{2,3}$",
        "description": "Slice key, e.g. gh-123/03",
        "type": "string"
      }
    },
    "status": {
      "anyOf": [
        {
          "const": "planned",
          "type": "string"
        },
        {
          "const": "active",
          "type": "string"
        },
        {
          "const": "integrated",
          "type": "string"
        },
        {
          "const": "dropped",
          "type": "string"
        }
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
