{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://norn.dev/schema/workflow-source.json",
  "title": "workflow file as written (norn)",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "name",
    "start",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9_-]*$",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "mode": {
      "anyOf": [
        {
          "const": "manual",
          "type": "string"
        },
        {
          "const": "auto",
          "type": "string"
        }
      ]
    },
    "defaults": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "deadline": {
          "pattern": "^([0-9]+(ms|s|m|h|d))+$",
          "description": "Duration like 30s, 10m, 1h30m",
          "type": "string"
        },
        "nudges": {
          "minimum": 0,
          "type": "integer"
        },
        "retries": {
          "minimum": 0,
          "type": "integer"
        },
        "stalled": {
          "pattern": "^([0-9]+(ms|s|m|h|d))+$",
          "description": "Duration like 30s, 10m, 1h30m",
          "type": "string"
        }
      }
    },
    "start": {
      "pattern": "^(?!(done|stuck|ask|exhausted|silent|died|timeout|stalled|stale)$)[a-z][a-z0-9_-]*$",
      "type": "string"
    },
    "steps": {
      "minProperties": 1,
      "additionalProperties": false,
      "type": "object",
      "patternProperties": {
        "^(?!(done|stuck|ask|exhausted|silent|died|timeout|stalled|stale)$)[a-z][a-z0-9_-]*$": {
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "agent",
                "outcomes"
              ],
              "properties": {
                "agent": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "description": "The orientation: what the step is for",
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "skills": {
                  "uniqueItems": true,
                  "description": "Skills the agent uses, in the order the brief names them",
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "inputs": {
                  "uniqueItems": true,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "const": "spec",
                            "type": "string"
                          },
                          {
                            "const": "slice",
                            "type": "string"
                          },
                          {
                            "const": "slices",
                            "type": "string"
                          },
                          {
                            "const": "diff",
                            "type": "string"
                          },
                          {
                            "const": "handoff",
                            "type": "string"
                          },
                          {
                            "const": "last_check",
                            "type": "string"
                          },
                          {
                            "const": "last_findings",
                            "type": "string"
                          },
                          {
                            "const": "record",
                            "type": "string"
                          },
                          {
                            "const": "resolution",
                            "type": "string"
                          },
                          {
                            "const": "base_side",
                            "type": "string"
                          }
