                          "properties": {
                            "to": {
                              "pattern": "^(\\$done|\\$stuck|(?!(done|stuck|ask|exhausted|silent|died|timeout|stalled|stale)$)[a-z][a-z0-9_-]*)$",
                              "type": "string"
                            },
                            "counter": {
                              "pattern": "^[a-z][a-z0-9_-]*$",
                              "type": "string"
                            },
                            "max": {
