                  "type": "string"
                },
                "outcomes": {
                  "minProperties": 1,
                  "additionalProperties": false,
                  "type": "object",
                  "patternProperties": {
                    "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)?$": {
                      "anyOf": [
                        {
                          "pattern": "^(\\$done|\\$stuck|(?!(done|stuck|ask|exhausted|silent|died|timeout|stalled|stale)$)[a-z][a-z0-9_-]*)$",
                          "type": "string"
                        },
                        {
                          "additionalProperties": false,
                          "type": "object",
                          "required": [
                            "to"
