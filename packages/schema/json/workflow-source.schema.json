                      },
                      {
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "file"
                        ],
                        "properties": {
                          "file": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "label": {
                            "minLength": 1,
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                },
                "model": {
                  "minLength": 1,
                  "type": "string"
                },
                "attended": {
                  "description": "Worked with a person; always started by a person",
                  "type": "boolean"
                },
                "deadline": {
                  "pattern": "^([0-9]+(ms|s|m|h|d))+$",
                  "description": "Duration like 30s, 10m, 1h30m",
                  "type": "string"
                },
                "nudges": {
                  "minimum": 0,
                  "description": "Max nudges in the same session",
                  "type": "integer"
                },
                "retries": {
                  "minimum": 0,
                  "description": "Max fresh-session retries after died",
                  "type": "integer"
                },
                "criteria": {
                  "const": "required",
                  "type": "string"
                },
                "hand_back": {
                  "minProperties": 1,
                  "additionalProperties": false,
                  "description": "Outcome → what its norn done must come with",
                  "type": "object",
                  "patternProperties": {
                    "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)?$": {
