{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "agent",
    "agents",
    "mode",
    "runner",
    "provider",
    "label",
    "git_remote",
    "sync_interval",
    "base_branch",
    "workflow",
    "slice_workflow",
    "norn_version",
    "max_agents",
    "notify",
    "interval",
    "claim",
    "trace",
    "record"
  ],
  "properties": {
    "agent": {
      "minLength": 1,
      "type": "string"
    },
    "agents": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "model": {
              "minLength": 1,
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "mode": {
      "anyOf": [
        {
          "const": "manual",
          "type": "string"
        },
        {
          "const": "auto",
          "type": "string"
        }
      ]
    },
    "runner": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "adapter"
      ],
      "properties": {
        "adapter": {
          "anyOf": [
            {
              "const": "herdr",
              "type": "string"
            },
            {
              "const": "headless",
              "type": "string"
            }
          ]
        }
      }
    },
    "provider": {
      "description": "Issue provider CLI: gh (GitHub) or glab (GitLab)",
      "anyOf": [
        {
          "const": "gh",
          "type": "string"
        },
        {
          "const": "glab",
          "type": "string"
        }
      ]
    },
    "label": {
      "minLength": 1,
      "type": "string"
    },
    "git_remote": {
      "minLength": 1,
      "type": "string"
    },
    "sync_interval": {
      "pattern": "^([0-9]+(ms|s|m|h|d))+$",
      "description": "Duration like 30s, 10m, 1h30m",
      "type": "string"
    },
    "base_branch": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "workflow": {
      "minLength": 1,
      "type": "string"
    },
    "slice_workflow": {
      "minLength": 1,
      "type": "string"
    },
    "norn_version": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_agents": {
      "minimum": 1,
      "maximum": 9,
      "type": "integer"
    },
    "notify": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "os"
      ],
      "properties": {
        "os": {
          "type": "boolean"
        },
        "ntfy": {
          "pattern": "^https?://\\S+$",
          "description": "http or https URL",
          "type": "string"
        },
        "webhook": {
          "pattern": "^https?://\\S+$",
          "description": "http or https URL",
          "type": "string"
        }
      }
    },
    "interval": {
      "pattern": "^([0-9]+(ms|s|m|h|d))+$",
      "description": "Duration like 30s, 10m, 1h30m",
      "type": "string"
    },
    "claim": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "lease",
        "renew"
      ],
      "properties": {
        "lease": {
          "pattern": "^([0-9]+(ms|s|m|h|d))+$",
          "description": "Duration like 30s, 10m, 1h30m",
          "type": "string"
        },
        "renew": {
          "pattern": "^([0-9]+(ms|s|m|h|d))+$",
          "description": "Duration like 30s, 10m, 1h30m",
          "type": "string"
        }
      }
    },
    "trace": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "retain"
      ],
      "properties": {
        "retain": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "record": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "anyOf": [
            {
              "const": "local",
              "type": "string"
            },
            {
              "const": "remote",
              "type": "string"
            }
          ]
        }
      }
    },
    "regenerate": {
      "description": "generated files: path globs and the command that rewrites them, so a base update conflicting only in them needs no agent",
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "paths",
          "run"
        ],
        "properties": {
          "paths": {
            "minItems": 1,
            "description": "path globs, repo-relative, of the files `run` writes",
            "type": "array",
            "items": {
              "minLength": 1,
              "type": "string"
            }
          },
          "run": {
            "minLength": 1,
            "description": "shell command, run at the repo root, that rewrites those files; fast and deterministic",
            "type": "string"
          },
          "timeout": {
            "pattern": "^([0-9]+(ms|s|m|h|d))+$",
            "description": "how long `run` may take, a duration like 2m (default 2m)",
            "type": "string"
          }
        }
      }
    }
  }
}
