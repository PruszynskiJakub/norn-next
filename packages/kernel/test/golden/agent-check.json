  "workflows": {
    "files": {
      "quick": {
        "name": "quick",
        "description": "Make a small change (refactor, docs, chore, a reproduced bug's fix), check and review it, open the draft PR, wait for CI.",
        "start": "sync",
        "steps": {
          "sync": {
            "update-branch": null,
            "outcomes": {
              "done": "implement",
              "conflict": {
                "to": "sync-resolve",
                "counter": "sync.conflict"
              },
              "clean": "implement",
              "resolved": "implement"
            }
          },
          "sync-resolve": {
            "outcomes": {
              "done": "sync"
            },
            "role": "builder",
            "agent": "Base mode: merge the base commit the base_side input names into the story branch in this worktree, resolve, commit the merge; never rebase.",
            "skills": [
              "norn-merge"
            ],
            "inputs": [
              "spec",
              "handoff",
              "base_side"
            ],
            "means": {
              "done": "base merged into the story branch, conflicts resolved and committed"
            }
          },
          "implement": {
            "outcomes": {
              "done": "update"
            },
            "role": "builder",
            "agent": "Work from what the story already holds: the Plan section of spec.md when a refinement round wrote one, otherwise the issue mirrored in spec.md and its latest `## Triage` comment. Keep to what they ask. A change in behaviour gets a test first; a change to docs or a pure refactor needs none beyond the suite staying green. A bug comes from a reproduce round with a red loop in the handoff's Notes and the issue's latest `## Reproduce` comment: turn it into a failing test at the seam named there before changing any code, then fix the cause.",
            "skills": [
              "norn-implement"
            ],
            "inputs": [
              "spec",
              "handoff",
              "last_check",
              "last_findings"
            ],
            "means": {
              "done": "the change is made; each behaviour change and rework point has a passing test"
            }
          },
          "update": {
            "update-branch": null,
            "outcomes": {
              "done": "test",
              "clean": "test-merge",
              "resolved": "test-resolution",
              "conflict": {
                "to": "resolve",
                "counter": "update.conflict"
              }
            }
          },
          "resolve": {
            "outcomes": {
              "done": "update"
            },
            "role": "builder",
            "agent": "Base mode: merge the base commit the base_side input names into the story branch in this worktree, resolve, commit the merge; never rebase. When Rework holds the resolution review's findings instead, fix the resolution they name and commit; never rebase.",
            "skills": [
              "norn-merge"
            ],
            "inputs": [
              "spec",
              "handoff",
              "base_side"
            ],
            "means": {
              "done": "base merged into the story branch, conflicts resolved and committed"
            }
          },
          "test": {
            "outcomes": {
              "pass": "review",
              "fail": {
                "to": "implement",
                "counter": "base-update.broken"
              }
            },
            "check": "{checks.test}",
            "timeout": "15m"
          },
          "test-merge": {
            "outcomes": {
              "pass": "open-pr",
              "fail": {
                "to": "implement",
                "counter": "base-update.broken"
              }
            },
            "check": "{checks.test}",
            "timeout": "15m"
          },
          "test-resolution": {
            "outcomes": {
              "pass": "resolution-review",
              "fail": {
                "to": "implement",
                "counter": "base-update.broken"
              }
            },
            "check": "{checks.test}",
            "timeout": "15m"
          },
          "resolution-review": {
            "outcomes": {
              "approve": "open-pr",
              "redescribe": "describe",
              "changes_requested": {
                "to": "resolve",
                "counter": "resolution-review.changes_requested"
              }
            },
            "role": "reviewer",
            "agent": "Review only the resolution: each remerge-diff under Inputs is where a merge differs from git's own merge of its parents, a base change the resolver dropped included. Judge whether it keeps the intent of both sides. Report `redescribe` when the merge danger pr.md describes no longer holds.",
            "skills": [
              "norn-review"
            ],
            "inputs": [
              "spec",
              "resolution"
            ],
            "means": {
              "approve": "the resolution keeps both sides' intent, no blocking findings; pr.md still describes the merge danger",
              "redescribe": "the resolution is sound, but the merge danger pr.md describes changed",
              "changes_requested": "blocking findings on the resolution, handed back as findings"
            },
            "hand_back": {
              "changes_requested": "findings"
            }
          },
          "review": {
            "outcomes": {
              "approve": "describe",
              "changes_requested": {
                "to": "implement",
                "counter": "review.changes_requested"
              }
            },
            "role": "reviewer",
            "agent": "Review the change against what the story asks (its Plan, or the issue and its latest triage): it does that and nothing else.",
            "skills": [
              "norn-review"
            ],
            "inputs": [
              "spec",
              "diff",
              "last_findings"
            ],
            "means": {
              "approve": "the change does what the story asks and nothing else, no blocking findings",
              "changes_requested": "blocking findings, handed back as findings"
            },
            "hand_back": {
              "changes_requested": "findings"
            }
          },
          "describe": {
            "outcomes": {
              "done": "open-pr"
            },
            "role": "writer",
            "agent": "Write the PR body to pr.md in the spec folder; norn puts the issue link under it.",
            "skills": [
              "norn-pr"
            ],
            "inputs": [
              "spec",
              "diff",
              "handoff"
            ],
            "means": {
              "done": "pr.md describes the branch as it is now: summary, evidence, merge danger"
            },
            "produces": {
              "pr_body": {
                "file": "pr.md"
              }
            }
          },
          "open-pr": {
            "open-pr": null,
            "outcomes": {
              "done": "ci"
            }
          },
          "ci": {
            "outcomes": {
              "pass": "ready",
              "fail": {
                "to": "implement",
                "counter": "ship.ci-failed"
              },
              "stale": {
                "to": "update",
                "counter": "ship.stale"
              }
            },
            "check": "command -v gh >/dev/null || { echo \"gh not found: no CI to wait for\"; exit 0; }\n# a repo with no GitHub remote (forge none, a local origin) has no PR and so no CI; any other gh failure fails\nif ! out=$(gh repo view --json name 2>&1); then\n  case \"$out\" in *\"none of the git remotes\"*|*\"no git remotes found\"*) echo \"no GitHub remote: no CI to wait for\"; exit 0 ;; esac\n  echo \"$out\"; exit 1\nfi\npr=$(gh pr view --json number -q .number) || exit 1\nsha=$(gh pr view --json headRefOid -q .headRefOid) || exit 1\n# GitHub starts no CI run on a PR that conflicts with its base: exit 3 is stale, the story\n# updates its branch instead of waiting. UNKNOWN is GitHub still computing: asked again briefly.\nmergeable() {\n  m=UNKNOWN\n  for i in 1 2 3 4 5 6; do\n    m=$(gh pr view \"$pr\" --json mergeable -q .mergeable) || return 1\n    [ \"$m\" != UNKNOWN ] && return 0\n    sleep 5\n  done\n}\nconflicting() { [ \"$m\" = CONFLICTING ] && echo \"PR conflicts with its base: no CI runs on it until the branch takes the base\"; }\nmergeable || exit 1\nconflicting && exit 3\nn=0\nfor i in $(seq 1 30); do\n  n=$(gh pr view \"$pr\" --json statusCheckRollup -q '.statusCheckRollup | length') || exit 1\n  [ \"$n\" -gt 0 ] && break\n  sleep 10\ndone\nif [ \"$n\" -eq 0 ]; then\n  mergeable || exit 1\n  conflicting && exit 3\n  echo \"no checks on PR #$pr after 5m (PR mergeable: $m): nothing to wait for\"\n  exit 0\nfi\ngh pr checks \"$pr\" --watch --interval 30 >/dev/null && exit 0\ngh pr checks \"$pr\"\n# where the failures are, never the log: a failed step's log buries the failure in passing output\ngh api \"repos/{owner}/{repo}/commits/$sha/check-runs?per_page=100\" -q '.check_runs[] | select(.conclusion==\"failure\") | \"- \\(.name) (id \\(.id)): \\(.details_url)\"'\necho \"Read a failed check run's annotations (file, line, message):\"\necho \"  gh api \\\"repos/{owner}/{repo}/check-runs/<id>/annotations\\\" -q '.[] | select(.annotation_level==\\\"failure\\\" and .path!=\\\".github\\\") | \\\"\\\\(.path):\\\\(.start_line) \\\\(.message)\\\"'\"\necho \"Only if that is not enough, the full log is behind its link.\"\nexit 1\n",
            "exits": {
              "3": "stale"
            },
            "timeout": "30m"
          },
          "ready": {
            "outcomes": {
              "approve": "merge",
              "reject": {
                "to": "implement",
                "counter": "ship.rejected"
              }
            },
            "gate": "Read the draft PR. Approve to wait for the merge (a person merges the PR), or reject with what to change.",
            "on": {
              "stale": {
                "to": "update",
                "counter": "ship.stale"
              },
              "unpushed": {
                "to": "open-pr",
                "counter": "ready.unpushed"
              }
            }
          },
          "merge": {
            "await-merge": null,
            "outcomes": {
              "merged": "$done"
            },
            "on": {
              "stale": {
                "to": "update",
                "counter": "ship.stale"
              },
              "unpushed": {
                "to": "open-pr",
                "counter": "merge.unpushed"
              }
            }
          }
        },
