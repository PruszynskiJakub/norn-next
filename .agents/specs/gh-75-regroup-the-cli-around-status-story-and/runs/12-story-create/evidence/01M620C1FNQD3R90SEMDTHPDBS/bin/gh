#!/usr/bin/env bun
// scripted gh for QA: state in $FAKE_GH_STATE, every call appended to $FAKE_GH_LOG
import { readFileSync, writeFileSync, appendFileSync, existsSync } from "node:fs";
const argv = process.argv.slice(2);
const S = process.env.FAKE_GH_STATE!, L = process.env.FAKE_GH_LOG!;
appendFileSync(L, JSON.stringify(argv) + "\n");
const st = existsSync(S) ? JSON.parse(readFileSync(S, "utf8")) : { issues: [] };
const save = () => writeFileSync(S, JSON.stringify(st));
const flag = (n: string) => { const i = argv.indexOf(n); return i >= 0 ? argv[i + 1] : undefined; };
const flags = (n: string) => argv.flatMap((a, i) => (argv[i - 1] === n ? a.split(",") : []));
const J = (i: any) => ({ number: i.number, url: `https://github.com/acme/app/issues/${i.number}`, title: i.title, body: i.body, state: "OPEN",
  assignees: i.assignees.map((a: string) => ({ id: "U", login: a, name: a })), labels: i.labels.map((l: string) => ({ id: "L", name: l, description: "", color: "ededed" })), updatedAt: "2026-10-28T09:00:00Z" });
const [a, b] = argv;
if (process.env.FAKE_GH_FAIL_CREATE && a === "issue" && b === "create") { console.error("HTTP 403: Resource not accessible by integration"); process.exit(1); }
if (a === "api" && b === "user") { console.log("qa-person"); process.exit(0); }
if (a === "auth" && b === "status") { console.log("Logged in"); process.exit(0); }
if (a === "issue" && b === "list") { const lab = flag("--label"); console.log(JSON.stringify(st.issues.filter((i: any) => i.assignees.includes("qa-person") && (!lab || i.labels.includes(lab))).map(J))); process.exit(0); }
if (a === "issue" && b === "create") { const i = { number: st.issues.length + 101, title: flag("--title"), body: flag("--body") ?? "", assignees: flags("--assignee"), labels: flags("--label") }; st.issues.push(i); save(); console.log(`\nCreating issue in acme/app\n\nhttps://github.com/acme/app/issues/${i.number}`); process.exit(0); }
if (a === "issue" && b === "view") { const i = st.issues.find((x: any) => x.number === Number(argv[2])); if (!i) { console.error("not found"); process.exit(1); } console.log(JSON.stringify(J(i))); process.exit(0); }
if (a === "repo" && b === "view") { console.log(JSON.stringify({ url: "https://github.com/acme/app" })); process.exit(0); }
if (a === "pr" && b === "list") { console.log("[]"); process.exit(0); }
console.error("fake gh: unexpected " + argv.join(" ")); process.exit(1);
