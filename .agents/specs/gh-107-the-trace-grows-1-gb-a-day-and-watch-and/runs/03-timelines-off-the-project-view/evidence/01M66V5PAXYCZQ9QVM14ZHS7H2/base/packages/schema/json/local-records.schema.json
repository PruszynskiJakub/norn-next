{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://norn.dev/schema/local-records.json",
  "title": "norn owed base-branch records (trace/records.json)",
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "story",
          "spec_dir",
          "status",
          "attempted_at",
          "attempts",
          "reason"
        ],
        "properties": {
          "story": {
            "type": "string"
          },
          "spec_dir": {
            "type": "string"
          },
          "status": {
            "const": "done",
            "type": "string"
          },
          "attempted_at": {
            "type": "number"
          },
          "attempts": {
            "minimum": 0,
            "type": "integer"
          },
          "reason": {
            "type": "string"
          },
          "merge": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "pr": {
                "minimum": 1,
                "type": "integer"
              },
              "url": {
                "minLength": 1,
                "type": "string"
              },
              "head_sha": {
                "pattern": "^[0-9a-f]{40,64}$",
                "type": "string"
              },
              "merge_commit_sha": {
                "pattern": "^[0-9a-f]{40,64}$",
                "type": "string"
              },
              "merged_by": {
                "minLength": 1,
                "type": "string"
              },
              "merged_at": {
                "format": "date-time",
                "description": "ISO-8601 timestamp, UTC",
                "type": "string"
              },
              "by_ancestry": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
