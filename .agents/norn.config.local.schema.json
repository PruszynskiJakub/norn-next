{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://norn.dev/schema/local-config.json",
  "title": "norn local config: you, in this repo",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "mode": {
      "anyOf": [
        {
          "const": "manual",
          "type": "string"
        },
        {
          "const": "auto",
          "type": "string"
        }
      ]
    },
    "agent": {
      "description": "claude, codex, opencode or gemini",
      "anyOf": [
        {
          "const": "claude",
          "type": "string"
        },
        {
          "const": "codex",
          "type": "string"
        },
        {
          "const": "opencode",
          "type": "string"
        },
        {
          "const": "gemini",
          "type": "string"
        }
      ]
    },
    "agents": {
      "additionalProperties": false,
      "description": "per agent: model and args, merged over the built-in entry",
      "type": "object",
      "properties": {
        "claude": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "model": {
              "minLength": 1,
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "codex": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "model": {
              "minLength": 1,
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "opencode": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "model": {
              "minLength": 1,
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "gemini": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "model": {
              "minLength": 1,
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
